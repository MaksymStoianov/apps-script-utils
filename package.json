{
  "name": "apps-script-utils",
  "version": "1.10.0",
  "description": "Utilities for Google Apps Script™ projects.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "sideEffects": false,
  "scripts": {
    "prepare": "husky && bash ./scripts/setup-merge-driver.sh",
    "dev": "vitest",
    "type:check": "tsc --noEmit && tsc --noEmit -p config/tsconfig.docs.json",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "build": "rm -rf dist/* && tsc -b --force",
    "build:gas": "npm run build && node scripts/gas/bundle.mjs scripts/gas/Library.js",
    "docs:generate": "node scripts/docs/generate-topics.mjs",
    "docs:check": "node scripts/docs/generate-topics.mjs --check",
    "docs:search-index": "node scripts/docs/build-search-index.mjs",
    "docs:finalize-site": "node scripts/docs/finalize-site.mjs",
    "docs:author": "node scripts/docs/author-guards.mjs && node scripts/docs/author-exceptions.mjs && node scripts/docs/author-batch.mjs",
    "docs:author-guards": "node scripts/docs/author-guards.mjs",
    "docs:author-exceptions": "node scripts/docs/author-exceptions.mjs",
    "docs:author-batch": "node scripts/docs/author-batch.mjs",
    "docs:verify-examples": "node scripts/docs/verify-examples.mjs",
    "docs:sync-examples": "node scripts/docs/sync-jsdoc-examples.mjs",
    "docs:sync-links": "node scripts/docs/sync-jsdoc-links.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaksymStoianov/apps-script-utils.git"
  },
  "keywords": [
    "google-apps-script",
    "googleappsscript",
    "apps-script",
    "appsscript",
    "gas",
    "clasp",
    "typescript",
    "javascript",
    "utilities",
    "library",
    "google-sheets",
    "google-drive",
    "google-docs",
    "google-forms",
    "google-slides",
    "google-admin-sdk",
    "sheets",
    "drive",
    "docs",
    "forms",
    "slides",
    "validation",
    "string-utils",
    "array-utils",
    "json-utils",
    "html-utils"
  ],
  "author": {
    "name": "Maksym Stoianov",
    "email": "stoianov.maksym@gmail.com",
    "url": "https://maksymstoianov.com"
  },
  "license": "Apache-2.0",
  "type": "module",
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "bugs": {
    "url": "https://github.com/MaksymStoianov/apps-script-utils/issues"
  },
  "homepage": "https://github.com/MaksymStoianov/apps-script-utils#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MaksymStoianov"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://buymeacoffee.com/MaksymStoianov"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/google-apps-script": "^2.0.12",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-googleappsscript": "^1.0.5",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.1.11"
  }
}
